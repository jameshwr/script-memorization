            {
              "episode": 1,
              "sentences": [
                {
                  "id": "ko_ep1_01",
                  "text": "넉넉하지는 않았지만 마음만은 따듯했던 시절이 있었다.",
                  "character": "성덕선 (내레이션)",
                  "translation": "虽然算不上宽裕，但内心却温暖如春，曾有过那样的时期。",
                  "pronunciation": "[넝너카진 아나찌만 마음마는 따드텃떤 시저리 이썯따] →↘",
                  "soundChange": "넉→넝(鼻音化)·각하→가카(送气化)·았지만→[아나찌만](紧音化)·따듯했던→[따드텃떤](连音+紧音)",
                  "grammar": [
                    {"point": "~지만", "desc": "连接词尾，虽然…但是…，连接两个相反或对比的分句。"},
                    {"point": "~지는 않다", "desc": "部分否定句式，는表示强调。"},
                    {"point": "~던", "desc": "回忆过去冠形词词尾，带有感情色彩。"}
                  ],
                  "context": "本集开篇德善的旁白，画面是1988年首尔双门洞的冬天。她在回忆童年——物质虽不丰富，但邻里间的温情让那个年代格外珍贵。",
                  "words": [
                    {"text": "넉넉하지는", "word": "넉넉하다", "pronun": "[넝너카다]", "pos": "形容词", "meaning": "充裕、宽裕、富足。形容生活条件、时间、金钱等充足有余。", "morph": {"base": "넉넉하다", "parts": [{"type": "词干", "text": "넉넉하"}, {"type": "否定词尾", "text": "~지"}, {"type": "强调补助词", "text": "는"}], "result": "넉넉하지는", "explain": "形容词词干 넉넉하- + 否定连接词尾 ~지 + 补助词 는（表示强调）。하다类形容词接 ~지 时词干保持不变。"}, "exKr": "그 집은 살림이 넉넉하다.", "exCn": "那户人家家境宽裕。", "audio": "audio/w1_neokneokhada.mp3"},
                    {"text": "않았지만", "word": "~지는 않다", "pronun": "~진 안타", "pos": "惯用型", "meaning": "并不…（部分否定句式）。는表示强调。", "morph": {"base": "않다", "parts": [{"type": "词干", "text": "않"}, {"type": "过去时", "text": "~았"}, {"type": "转折词尾", "text": "~지만"}], "result": "않았지만", "explain": "않다（否定辅助动词）词干 않- + 过去时词尾 ~았 + 转折连接词尾 ~지만。表示虽然并不（那样做过）。"}, "exKr": "나는 그 사람을 잘 알지는 못한다.", "exCn": "我并不太了解那个人。", "audio": ""},
                    {"text": "마음만은", "word": "마음", "pronun": "마음", "pos": "名词", "meaning": "心、内心、心意、心情。指人的内在情感和想法。", "morph": {"base": "마음", "parts": [{"type": "名词", "text": "마음"}, {"type": "限定补助词", "text": "~만"}, {"type": "主题补助词", "text": "~은"}], "result": "마음만은", "explain": "名词 마음 + 限定补助词 ~만（只、只有）+ 主题补助词 ~은（强调主语）。~만은 表示唯独…只有…，带强调语气。"}, "exKr": "마음이 따뜻하다.", "exCn": "心地温暖。", "audio": "audio/w2_maeum.mp3"},
                    {"text": "따듯했던", "word": "따뜻하다", "pronun": "[따드타다]", "pos": "形容词", "meaning": "温暖的、暖和的。可形容温度，也可形容人心的温暖。", "morph": {"base": "따뜻하다", "parts": [{"type": "口语形", "text": "따뜻→따듯"}, {"type": "过去时", "text": "~했"}, {"type": "回忆冠形词尾", "text": "~던"}], "result": "따듯했던", "explain": "따뜻하다的口语缩略形 따듯하다 + 过去时~았→했 + 回忆冠形词尾~던。~던带有对过去经历的追忆和感情色彩。"}, "exKr": "날씨가 따뜻하다.", "exCn": "天气暖和。", "audio": "audio/w3_ttatteuthada.mp3"},
                    {"text": "시절이", "word": "시절", "pronun": "시절", "pos": "名词", "meaning": "时期、时节、年代。特指人生中的某段时光。", "morph": {"base": "시절", "parts": [{"type": "名词", "text": "시절"}, {"type": "主语助词", "text": "~이"}], "result": "시절이", "explain": "名词 시절 + 主语助词 ~이（用于无韵尾结尾的名词后）。"}, "exKr": "학생 시절이 그립다.", "exCn": "怀念学生时代。", "audio": "audio/w4_sijeol.mp3"},
                    {"text": "있었다.", "word": "있다", "pronun": "[이따]", "pos": "动词", "meaning": "有、存在。表示事物的存在或拥有。", "morph": {"base": "있다", "parts": [{"type": "词干", "text": "있"}, {"type": "过去时", "text": "~었"}, {"type": "终结词尾", "text": "~다"}], "result": "있었다", "explain": "있다（存在动词）词干 있- + 过去时词尾 ~었 + 终结词尾 ~다。表示曾经有过/存在过。"}, "exKr": "꿈이 있다.", "exCn": "有梦想。", "audio": "audio/w5_itda.mp3"}
                  ],
                  "romaji": "",
                  "audio": {"full": "audio/s1_full.mp3", "slow": "audio/s1_slow.mp3"},
                  "memorizationTips": {"rhythm": "넉넉하지는 / 않았지만 / 마음만은 / 따듯했던 / 시절이 / 있었다", "stress": "**따**듯**했**던 | **시**절이 **이**썯따", "emotion": "怀念、温柔、带一丝感慨，语调整体平缓→句末缓缓落下"}
                },
                {
                  "id": "ko_ep1_02",
                  "text": "여전히 냉기가 가득했지만 가슴은 뜨거웠고 설명임을 알았다.",
                  "character": "성덕선 (내레이션)",
                  "translation": "虽然依然寒气逼人，但内心火热，我知道这就是 설명。",
                  "pronunciation": "[여저니 냉기가 가드캇찌만 가슴은 뜨거웃꼬 설명이믈 아란따]",
                  "soundChange": "생각하면→[생가카면](ㄱ+ㅎ→ㅋ)·가득했지만→[가드캇찌만](ㄱ+ㅎ→ㅋ, ㅆ+ㅈ→ㅉ)·뜨거웠고→[뜨거웃꼬](ㅂ불규칙)",
                  "grammar": [
                    {"point": "~지만", "desc": "连接词尾，虽然…但是…。"},
                    {"point": "~고", "desc": "并列词尾，并且、同时。"},
                    {"point": "~ㄹ/을 줄 알다", "desc": "知道/会做某事。表示对事实的认知。"}
                  ],
                  "context": "德善旁白继续，描述那个冬天的寒冷与人们内心的温暖之间的对比。",
                  "words": [
                    {"text": "여전히", "word": "여전히", "pronun": "[여저니]", "pos": "副词", "meaning": "仍然、依旧、依然。表示状态没有变化。", "morph": {"base": "여전하다", "parts": [{"type": "词干", "text": "여전"}, {"type": "副词化词尾", "text": "~히"}], "result": "여전히", "explain": "여전하다（依然如故）的词干 여전- + 副词化词尾 ~히。~히将形容词变为副词。发音：전+히→[저니]（ㅈ遇ㅎ颚化）。"}, "exKr": "그는 여전히 젊어 보인다.", "exCn": "他看起来依然年轻。", "audio": ""},
                    {"text": "냉기가", "word": "냉기", "pronun": "냉기", "pos": "名词", "meaning": "冷气、寒气。指寒冷的空气或气氛。", "morph": null, "exKr": "냉기가 느껴지다.", "exCn": "感觉到寒气。", "audio": ""},
                    {"text": "가득했지만", "word": "가득하다", "pronun": "[가드카다]", "pos": "形容词", "meaning": "满满的、充满的。", "morph": {"base": "가득하다", "parts": [{"type": "词干", "text": "가득하"}, {"type": "过去时", "text": "~았→했"}, {"type": "转折词尾", "text": "~지만"}], "result": "가득했지만", "explain": "가득하다词干 가득하- + 过去时~았(与하融合为했) + 转折词尾~지만。"}, "exKr": "방에 사람이 가득하다.", "exCn": "房间里挤满了人。", "audio": ""},
                    {"text": "가슴은", "word": "가슴", "pronun": "[가슴]", "pos": "名词", "meaning": "胸、胸部；也指内心、心胸。", "morph": {"base": "가슴", "parts": [{"type": "名词", "text": "가슴"}, {"type": "主题助词", "text": "~은"}], "result": "가슴은", "explain": "名词 가슴 + 主题助词 ~은。"}, "exKr": "가슴이 두근거리다.", "exCn": "心跳加速。", "audio": ""},
                    {"text": "뜨거웠고", "word": "뜨겁다", "pronun": "[뜨겁따]", "pos": "形容词", "meaning": "热的、烫的。温度高，也可形容热情。", "morph": {"base": "뜨겁다", "parts": [{"type": "词干", "text": "뜨겁"}, {"type": "ㅂ不规则变形", "text": "뜨거웠"}, {"type": "并列词尾", "text": "~고"}], "result": "뜨거웠고", "explain": "뜨겁다词干 뜨겁- 发生ㅂ不规则变形：ㅂ+过去时~었→ㅂ脱落变为우，合成 뜨거웠-。再接并列词尾~고。"}, "exKr": "날씨가 뜨겁다.", "exCn": "天气炎热。", "audio": ""}
                  ],
                  "romaji": "",
                  "audio": {"full": "", "slow": ""},
                  "memorizationTips": {"rhythm": "여전히 / 냉기가 / 가득했지만 / 가슴은 / 뜨거웠고", "stress": "**여**전히 **가**득**했**지만", "emotion": "感慨、对比，语调先沉后扬"}
                },
                {
                  "id": "ko_ep1_03",
                  "text": "가난하지만 억척스럽게 살아온 우리네 동네 사람들 얼굴에는",
                  "character": "성덕선 (내레이션)",
                  "translation": "虽然贫穷，但顽强地生活过来的我们小区人们的脸上，",
                  "pronunciation": "[가나나찌만 억처크스럽께 사라온 우리네 동네 사람드 얼굴에네]",
                  "soundChange": "가난하지만→[가나나찌만](ㄴ+ㅎ→ㅊ)",
                  "grammar": [
                    {"point": "~지만", "desc": "连接词尾，虽然…但是…。"},
                    {"point": "~아/어/여 오다", "desc": "表示动作从过去持续到现在。"}
                  ],
                  "context": "德善介绍双门洞邻居们的性格——虽然贫穷但坚韧乐观。",
                  "words": [
                    {"text": "가난하지만", "word": "가난하다", "pronun": "[가나나다]", "pos": "形容词", "meaning": "贫穷的、贫困的。", "morph": {"base": "가난하다", "parts": [{"type": "词干", "text": "가난하"}, {"type": "转折词尾", "text": "~지만"}], "result": "가난하지만", "explain": "가난하다词干 가난하- + 转折词尾 ~지만。"}, "exKr": "가난한 집에서 태어났다.", "exCn": "出生在贫困的家庭。", "audio": ""},
                    {"text": "억척스럽게", "word": "억척스럽다", "pronun": "[억처크스럽따]", "pos": "形容词", "meaning": "顽强的、坚韧的、吃苦耐劳的。", "morph": {"base": "억척스럽다", "parts": [{"type": "词干", "text": "억척스럽"}, {"type": "副词化词尾", "text": "~게"}], "result": "억척스럽게", "explain": "억척스럽다词干 + 副词化词尾 ~게（变成副词形式）。"}, "exKr": "억척스럽게 살아가다.", "exCn": "顽强地生活下去。", "audio": ""},
                    {"text": "살아온", "word": "살다", "pronun": "살다", "pos": "动词", "meaning": "活、生活、居住。", "morph": {"base": "살다", "parts": [{"type": "词干", "text": "살"}, {"type": "持续词尾", "text": "~아 오다→아온"}, {"type": "冠形词尾", "text": "~ㄴ"}], "result": "살아온", "explain": "살다词干 살- + ~아 오다（持续到现在的动作）→过去冠形词形 살아온。表示从过去一直活到现在。"}, "exKr": "20년간 이 동네에서 살았다.", "exCn": "在这个小区住了20年。", "audio": ""},
                    {"text": "우리네", "word": "우리", "pronun": "우리", "pos": "代词", "meaning": "我们。", "morph": {"base": "우리", "parts": [{"type": "代词", "text": "우리"}, {"type": "复数后缀", "text": "~네"}], "result": "우리네", "explain": "우리 + ~네（表示我们那边的/我们这伙的）。"}, "exKr": "우리네 동네", "exCn": "我们小区。", "audio": ""},
                    {"text": "동네", "word": "동네", "pronun": "동네", "pos": "名词", "meaning": "村子、小区、街区。", "morph": null, "exKr": "조용한 동네에 살다.", "exCn": "住在安静的小区。", "audio": ""}
                  ],
                  "romaji": "",
                  "audio": {"full": "", "slow": ""},
                  "memorizationTips": {"rhythm": "가난하지만 / 억척스럽게 / 살아온 / 우리네 / 동네 사람들", "stress": "**가**난**하**지만 **억**척**스럽**게", "emotion": "自豪、坚韧，语调有力"}
                },
                {
                  "id": "ko_ep1_04",
                  "text": "동네 사람들은 누가 시켜서가 아니라 그냥 하던 거야.",
                  "character": "성덕선 (내레이션)",
                  "translation": "小区的人们不是因为谁让做才做的，就是自然而然做的事。",
                  "pronunciation": "[동네 사람드른 누가 시켜서가 아니라 그냥 하던 거야]",
                  "soundChange": "사람들은→[사람드른](ㄴ+ㄷ→ㄹ+ㄹ连音)",
                  "grammar": [
                    {"point": "~아/어서가 아니라", "desc": "不是因为…而是…。表示否定前因，引出真正原因。"},
                    {"point": "~던 거야", "desc": "거야=것이야的口语缩略。~던表示过去回忆。"}
                  ],
                  "context": "德善感叹邻里之间自发分享食物，不是被人要求，而是自然而然的习惯。",
                  "words": [
                    {"text": "동네", "word": "동네", "pronun": "동네", "pos": "名词", "meaning": "村子、小区、街区。", "morph": null, "exKr": "우리 동네", "exCn": "我们小区", "audio": ""},
                    {"text": "사람들은", "word": "사람", "pronun": "사람", "pos": "名词", "meaning": "人、人们。", "morph": {"base": "사람들", "parts": [{"type": "名词", "text": "사람"}, {"type": "复数后缀", "text": "~들"}, {"type": "主题助词", "text": "~은"}], "result": "사람들은", "explain": "사람 + ~들（复数）+ ~은（主题助词）。"}, "exKr": "사람들이 많다.", "exCn": "人很多。", "audio": ""},
                    {"text": "누가", "word": "누구", "pronun": "누가", "pos": "代词", "meaning": "谁。", "morph": {"base": "누구", "parts": [{"type": "代词词干", "text": "누구→누가"}], "result": "누가", "explain": "누구 + 主语助词 ~가 → 누구가 → 缩约为 누가。"}, "exKr": "누가 왔어?", "exCn": "谁来了？", "audio": ""},
                    {"text": "시켜서가", "word": "시키다", "pronun": "[시케서가]", "pos": "动词", "meaning": "使、让、命令。", "morph": {"base": "시키다", "parts": [{"type": "词干", "text": "시키"}, {"type": "原因词尾", "text": "~어서"}, {"type": "主语助词", "text": "~가"}], "result": "시켜서가", "explain": "시키다词干 시키- + ~어서（原因词尾）+ ~가（主语助词，用于强调原因）。"}, "exKr": "엄마가 시킨 일이다.", "exCn": "是妈妈让做的事。", "audio": ""},
                    {"text": "아니라", "word": "아니다", "pronun": "[아니라]", "pos": "形容词/惯用", "meaning": "不是…而是…。", "morph": {"base": "아니다", "parts": [{"type": "词干", "text": "아니"}, {"type": "连接词尾", "text": "~라"}], "result": "아니라", "explain": "아니다词干 아니- + ~라（表示否定前句，引出后句的真正内容）。"}, "exKr": "돈이 아니라 시간이 필요하다.", "exCn": "需要的不是钱而是时间。", "audio": ""},
                    {"text": "그냥", "word": "그냥", "pronun": "그냥", "pos": "副词", "meaning": "就那样、直接、自然而然地。", "morph": null, "exKr": "그냥 두세요.", "exCn": "就这样放着吧。", "audio": ""},
                    {"text": "하던", "word": "하다", "pronun": "하다", "pos": "动词", "meaning": "做。", "morph": {"base": "하다", "parts": [{"type": "词干", "text": "하"}, {"type": "回忆冠形词尾", "text": "~던"}], "result": "하던", "explain": "하다词干 하- + ~던（回忆冠形词尾）。"}, "exKr": "하던 대로 해.", "exCn": "按原来的做。", "audio": ""},
                    {"text": "거야", "word": "것", "pronun": "[거야]", "pos": "依存名词", "meaning": "…的事（口语缩略形 것이야→거야）。", "morph": {"base": "것", "parts": [{"type": "依存名词", "text": "것→거"}, {"type": "终结词尾", "text": "~이야→야"}], "result": "거야", "explain": "것（依存名词）口语形 거 + ~이야→缩约为 거야。表示就是…那样。"}, "exKr": "내가 할 거야.", "exCn": "我会做的。", "audio": ""}
                  ],
                  "romaji": "",
                  "audio": {"full": "", "slow": ""},
                  "memorizationTips": {"rhythm": "동네 사람들은 / 누가 시켜서가 / 아니라 / 그냥 / 하던 거야", "stress": "**아**니라 **그**냥 **하**던 거야", "emotion": "自然、温暖、自豪"}
                },
                {
                  "id": "ko_ep1_05",
                  "text": "그게 그 시절 우리네 동네의 인심이었다.",
                  "character": "성덕선 (내레이션)",
